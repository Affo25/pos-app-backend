{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "echo \"Backend ready for Vercel\"",
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/", "destination": "/api" }
  ],
  "functions": {
    "api/[[...path]].js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
